# ---------------------------------------------------------------------------
# Trip Tracker API
# Copy to .env and fill in. Nothing here is optional in production: the server
# refuses to start without JWT_SECRET and DATABASE_URL when NODE_ENV=production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# Leave DATABASE_URL unset locally to use SQLite (better-sqlite3, file-backed).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trip_together
# strict = verify the server certificate. Use no-verify only for providers that
# present a self-signed certificate and publish no CA bundle.
DATABASE_SSL=strict
# SQLITE_PATH=./trip_together.db

# Optional. Required for more than one API instance: without it live positions and
# WebSocket fan-out stay inside a single process.
# REDIS_URL=redis://localhost:6379

# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Routing is proxied through the API so member coordinates never reach a third
# party from the browser. Point this at your own OSRM instance for production use;
# the public demo server is rate-limited and not intended for real traffic.
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=6000

# Retention: positions older than this are deleted by a periodic sweep.
LOCATION_EXPIRY_DAYS=30
RETENTION_SWEEP_HOURS=6

# Consent backstop. The 'once' and 'while_using' levels promise that sharing stops when
# the member leaves the trip screen; a browser closed abruptly never gets to say so, so a
# member on one of those levels who has reported nothing for this long is switched off.
SHARING_IDLE_MINUTES=15
SHARING_SWEEP_SECONDS=60

# Bounds on client-supplied timestamps; anything outside is replaced by server time.
LOCATION_FUTURE_SKEW_MIN=5
LOCATION_PAST_SKEW_MIN=1440

# Response caps for history and export.
HISTORY_MAX_ROWS=5000
EXPORT_MAX_ROWS=50000
