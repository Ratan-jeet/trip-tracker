# API base URL. In production this must be https.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: derived from NEXT_PUBLIC_API_URL when unset, which is the recommended
# setup. Set it only when the socket is served from a different host. The `/ws` path is
# appended automatically — omitting it was why the socket never connected.
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# No map token is needed: the map renders with MapLibre GL against OpenStreetMap
# raster tiles. The old NEXT_PUBLIC_MAPBOX_TOKEN was documented but never read by
# any code — the app has never used Mapbox.
